<?php
$title = 'Kontakt löschen';
$this->headTitle($title);
?>

<div class="container mt-4">
    <h1><?= $this->escapeHtml($title) ?></h1>

    <div class="alert alert-warning">
        <h4 class="alert-heading">Sind Sie sicher?</h4>
        <p>Sie sind dabei, den folgenden Kontakt endgültig zu löschen:</p>
        <hr>
        <p class="mb-0">
            <strong><?= $this->escapeHtml($this->contact->name) ?></strong>
            <?php if ($this->contact->email): ?>
                <br>E-Mail: <?= $this->escapeHtml($this->contact->email) ?>
            <?php endif; ?>
            <?php if ($this->contact->phone): ?>
                <br>Telefon: <?= $this->escapeHtml($this->contact->phone) ?>
            <?php endif; ?>
        </p>
    </div>

    <form method="post" action="<?= $this->url('contact', ['action' => 'delete', 'id' => $this->id]) ?>">
        <div class="mb-3">
            <button type="submit" name="del" value="Ja" class="btn btn-danger">
                Ja, löschen
            </button>
            <a href="<?= $this->url('contact') ?>" class="btn btn-secondary">
                Nein, abbrechen
            </a>
        </div>
    </form>
</div>
