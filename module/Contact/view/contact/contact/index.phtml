<?php
$title = 'Kontakte';
$this->headTitle($title);
?>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><?= $this->escapeHtml($title) ?></h1>
        <a href="<?= $this->url('contact', ['action' => 'add']) ?>" class="btn btn-success">
            + Neuer Kontakt
        </a>
    </div>

    <?php if (count($this->contacts) === 0): ?>
        <div class="alert alert-info">
            Noch keine Kontakte vorhanden.
            <a href="<?= $this->url('contact', ['action' => 'add']) ?>">Ersten Kontakt anlegen</a>
        </div>
    <?php else: ?>
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>E-Mail</th>
                    <th>Telefon</th>
                    <th>Erstellt am</th>
                    <th>Aktionen</th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($this->contacts as $contact): ?>
                    <tr>
                        <td><?= $this->escapeHtml($contact->id) ?></td>
                        <td><strong><?= $this->escapeHtml($contact->name) ?></strong></td>
                        <td>
                            <?php if ($contact->email): ?>
                                <a href="mailto:<?= $this->escapeHtml($contact->email) ?>">
                                    <?= $this->escapeHtml($contact->email) ?>
                                </a>
                            <?php else: ?>
                                <span class="text-muted">-</span>
                            <?php endif; ?>
                        </td>
                        <td>
                            <?php if ($contact->phone): ?>
                                <a href="tel:<?= $this->escapeHtml($contact->phone) ?>">
                                    <?= $this->escapeHtml($contact->phone) ?>
                                </a>
                            <?php else: ?>
                                <span class="text-muted">-</span>
                            <?php endif; ?>
                        </td>
                        <td>
                            <?= $contact->created_at ? date('d.m.Y H:i', strtotime($contact->created_at)) : '-' ?>
                        </td>
                        <td>
                            <a href="<?= $this->url('contact', ['action' => 'edit', 'id' => $contact->id]) ?>"
                               class="btn btn-sm btn-outline-primary">
                                Bearbeiten
                            </a>
                            <a href="<?= $this->url('contact', ['action' => 'delete', 'id' => $contact->id]) ?>"
                               class="btn btn-sm btn-outline-danger">
                                Löschen
                            </a>
                        </td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</div>
