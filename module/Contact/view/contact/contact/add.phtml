<?php
$title = 'Neuen Kontakt anlegen';
$this->headTitle($title);
$form = $this->form;
$form->setAttribute('action', $this->url('contact', ['action' => 'add']));
$form->prepare();
?>

<div class="container mt-4">
    <h1><?= $this->escapeHtml($title) ?></h1>

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <?= $this->form()->openTag($form) ?>

            <div class="mb-3">
                <?= $this->formLabel($form->get('name')) ?>
                <?= $this->formElement($form->get('name')) ?>
                <?= $this->formElementErrors($form->get('name')) ?>
            </div>

            <div class="mb-3">
                <?= $this->formLabel($form->get('email')) ?>
                <?= $this->formElement($form->get('email')) ?>
                <?= $this->formElementErrors($form->get('email')) ?>
            </div>

            <div class="mb-3">
                <?= $this->formLabel($form->get('phone')) ?>
                <?= $this->formElement($form->get('phone')) ?>
                <?= $this->formElementErrors($form->get('phone')) ?>
            </div>

            <div class="mb-3">
                <?= $this->formLabel($form->get('notes')) ?>
                <?= $this->formElement($form->get('notes')) ?>
                <?= $this->formElementErrors($form->get('notes')) ?>
            </div>

            <div class="mb-3">
                <?= $this->formSubmit($form->get('submit')) ?>
                <a href="<?= $this->url('contact') ?>" class="btn btn-secondary">Abbrechen</a>
            </div>

            <?= $this->formHidden($form->get('id')) ?>
            <?= $this->form()->closeTag() ?>
        </div>
    </div>
</div>
