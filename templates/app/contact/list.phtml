<?php $this->layout('layout::default') ?>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Kontakte</h1>
    <a href="/contact/create" class="btn btn-success">+ Neuer Kontakt</a>
</div>

<?php if (count($this->contacts) === 0): ?>
    <div class="alert alert-info">
        Noch keine Kontakte vorhanden.
        <a href="/contact/create">Ersten Kontakt anlegen</a>
    </div>
<?php else: ?>
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>E-Mail</th>
                    <th>Telefon</th>
                    <th>Erstellt</th>
                    <th>Aktionen</th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($this->contacts as $contact): ?>
                    <tr>
                        <td><?= $this->escapeHtml($contact->id) ?></td>
                        <td><strong><?= $this->escapeHtml($contact->name) ?></strong></td>
                        <td>
                            <?php if ($contact->email): ?>
                                <a href="mailto:<?= $this->escapeHtml($contact->email) ?>">
                                    <?= $this->escapeHtml($contact->email) ?>
                                </a>
                            <?php else: ?>
                                <span class="text-muted">-</span>
                            <?php endif; ?>
                        </td>
                        <td>
                            <?php if ($contact->phone): ?>
                                <a href="tel:<?= $this->escapeHtml($contact->phone) ?>">
                                    <?= $this->escapeHtml($contact->phone) ?>
                                </a>
                            <?php else: ?>
                                <span class="text-muted">-</span>
                            <?php endif; ?>
                        </td>
                        <td>
                            <?= $contact->created_at ? date('d.m.Y H:i', strtotime($contact->created_at)) : '-' ?>
                        </td>
                        <td>
                            <a href="/contact/edit/<?= $contact->id ?>" class="btn btn-sm btn-outline-primary">
                                Bearbeiten
                            </a>
                            <a href="/contact/delete/<?= $contact->id ?>" class="btn btn-sm btn-outline-danger">
                                Löschen
                            </a>
                        </td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
<?php endif; ?>
